{
  // Project-wide markdownlint configuration.
  // Rules are tuned for CommonMark compliance while tolerating
  // long Russian text and mermaid diagrams used in architecture docs.
  "config": {
    "default": true,
    "MD013": { "line_length": 120 },
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD034": false,
    "MD041": false
  },
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "node_modules/**",
    ".roo/**",
    "Diamond Universe.md"
  ]
}
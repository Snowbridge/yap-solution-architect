    <element xsi:type="archimate:BusinessObject" name="Первичные документы складского уечта" id="id-a9077f18610c4bc7aa69e7e07b4dd747">
      <documentation>- Оприходование&#xD;
- Реализация&#xD;
- Перемещение&#xD;
- Инвентаризация&#xD;
- Списание</documentation>
    </element>

    <element xsi:type="archimate:BusinessProcess" name="Учет контрагентов и договоров" id="id-9169c54fbdb743f4b71385b00f137da4">
      <documentation>SSOT по контрагентам и договорам для всей компании</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Учет обязательств и взаиморасчетов" id="id-5d8474267baf43a0ba40f9e43756b33b"/>
    <element xsi:type="archimate:BusinessObject" name="Зарегистрированные участники" id="id-c3a144cb7a4246f7a18d3a4cd5d06816"/>
    <element xsi:type="archimate:BusinessProcess" name="Бухгалтерский учет ТМЦ" id="id-505bb645bbea4dbcaa27bf988caec4a4"/>

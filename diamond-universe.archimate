  <folder name="Business" id="id-5562d349fe874c2a809bb74c57b3d7be" type="business">
    <element xsi:type="archimate:BusinessProcess" name="Приемка и идентификация алмазов" id="id-93fa7708c3444997a60565c65eb23566">
      <documentation>Приемка из производстав, фотографирование, взвешивание, обмер, присвоение УИН и формирование кчетной карточки</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Учетная карточка алмаза" id="id-803ec82b8c4d4a3a8fc00cd6481b0e84"/>
    <element xsi:type="archimate:BusinessProcess" name="Планирование и организация аукционов" id="id-9c8e28dfda334f4688c26120885cfb67">
      <documentation>Учетные карточки превращаются в лоты, лоты компонуются в аукционные предложения.&#xD;
Планируются даты аукционов, запускаются приглашения и рекламные кампании.</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Аукцион" id="id-7f3efe75092a46a1ab3ce125db020961">
      <documentation>Набор лотов, даты проведения, условия участия, инач информация</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Проведение оффлайн аукциона" id="id-05b53be936dd48c3bef9d26aa8ce5663"/>
    <element xsi:type="archimate:BusinessProcess" name="Сопровождение аукционов" id="id-a14ca70219e847d1b95f138b7252222f">
      <documentation>Организация выпука пропусков в хранилище для экспертов&#xD;
Регистрация протокола торгов&#xD;
Организация подписания договров купли-продажи&#xD;
Запуск заявок на доставку</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Заявка на доставку" id="id-693a88dde8664f93820800ec430a704c"/>
    <element xsi:type="archimate:BusinessObject" name="Протокол торгов" id="id-d01c0e130b264b9dbdcfdd549745b3e3"/>
    <element xsi:type="archimate:BusinessProcess" name="Складской учет алмазов" id="id-6d1e9fedd92a4adc8135698e793d0771">
      <documentation>Оприходование и реализация&#xD;
Перемещения по местам хранения&#xD;
Инвентаризация и списание</documentation>
    </element>
    <element xsi:type="archimate:BusinessObject" name="Заключенные сделки" id="id-c0d169d3145a4e2288bc1303620cf849"/>
    <element xsi:type="archimate:BusinessProcess" name="Организация доставки" id="id-0b1a958eae1a42588145cdf5b1e8bb16"/>
    <element xsi:type="archimate:BusinessProcess" name="Сопровождение грузоперевозки" id="id-8c1e357a7c7843abb2bec2e33afe833a"/>
